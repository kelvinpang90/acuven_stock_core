# 服务器上本目录的 .env 模板（.env 本身不进仓库）。下面都是示例值，不是真实配置。

# demo 或 production；只在启动时读。Demo 实例与生产实例各有自己的检出目录与 .env（docs/PRODUCTION_AND_RECOVERY.md）。
CORE_ENV=demo

# 共享 infra_mysql 里给 Core 单独建的库与账号（最小权限）。
CORE_DATABASE_URL=mysql+pymysql://stock_core:CHANGE_ME@db-host:3306/stock_core_demo

# 预留有效期（秒），60–3600，默认 900；只在启动时读（契约 5.6）。不设即用默认值。
CORE_RESERVATION_TTL_SECONDS=900

# 巡检脚本 deploy/monitor.sh 读的键（契约 8.5）；只在生产实例的 .env 里写，Demo 不装巡检（契约 0.20）。应用容器不读它们。下面都是示例值。
# ops.read 运维凭据的令牌，由运维命令行签发；只给巡检用。
CORE_MONITOR_TOKEN=CHANGE_ME
# 心跳服务里两个检查的地址：readyz 那个合并 readyz 与 periodic 两个维度，invariants 单独一个；没配的检查不会通知任何人。
CORE_HEALTHCHECK_READYZ_URL=https://heartbeat.example/ping/readyz-check-id
CORE_HEALTHCHECK_INVARIANTS_URL=https://heartbeat.example/ping/invariants-check-id
